service : {
  _immutableObjectStorageBlobsAreLive: (hashes: vec blob) -> (vec bool) query;
  _immutableObjectStorageBlobsToDelete: () -> (vec blob) query;
  _immutableObjectStorageConfirmBlobDeletion: (blobs: vec blob) -> ();
  _immutableObjectStorageCreateCertificate: (blobHash: text) ->
   (_ImmutableObjectStorageCreateCertificateResult);
  _immutableObjectStorageRefillCashier: (refillInformation:
   opt _ImmutableObjectStorageRefillInformation) ->
   (_ImmutableObjectStorageRefillResult);
  _immutableObjectStorageUpdateGatewayPrincipals: () -> ();
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  addLabor: (token: opt text, id: Id, input: LaborInput) -> (OrderView);
  addOrderPart: (token: opt text, id: Id, input: OrderPartInput) ->
   (OrderView);
  addOrderPhoto: (token: opt text, id: Id, input: OrderPhotoInput) ->
   (OrderView);
  adjustStock: (token: opt text, input: AdjustmentInput) -> (Movement);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  assignTechnician: (token: opt text, id: Id, technicianId: Id) ->
   (OrderView);
  bulkCreateCustomers: (token: opt text, inputs: vec CustomerInput) ->
   (BulkResult);
  bulkCreateParts: (token: opt text, inputs: vec PartInput) -> (BulkResult);
  bulkCreateServices: (token: opt text, inputs: vec ServiceInput) ->
   (vec Service);
  bulkUpdateCustomers: (token: opt text, updates:
   vec record {
         Id;
         CustomerInput;
       }) -> (BulkResult);
  bulkUpdateParts: (token: opt text, updates: vec record {
                                                    Id;
                                                    PartInput;
                                                  }) -> (BulkResult);
  bulkUpdateServices: (token: opt text, updates:
   vec record {
         Id;
         ServiceInput;
       }) -> (vec Service);
  cancelOrder: (token: opt text, id: Id, reason: text) -> (OrderView);
  changeOwnPassword: (token: text, currentPassword: text, newPassword:
   text) -> (bool);
  closeShift: (token: opt text, id: Id, input: CloseShiftInput) -> (Shift);
  /// Completa la autorización OAuth con el código devuelto por Google.
  completeDriveAuthorization: (token: opt text, code: text, state: text) ->
   (DriveAuthResult);
  confirmPurchaseInvoice: (token: opt text, invoiceId: Id) ->
   (InvoiceApplyResult);
  convertAppointmentToOrder: (token: opt text, id: Id) -> (OrderView);
  convertQuoteToInvoice: (token: opt text, id: Id, paymentMethod:
   PaymentMethod) -> (Invoice);
  convertQuoteToOrder: (token: opt text, id: Id) -> (OrderView);
  createAppointment: (token: opt text, input: AppointmentInput) ->
   (Appointment);
  /// Genera el respaldo y lo sube al Drive del administrador.
  createBackup: (token: opt text) -> (BackupOutcome);
  createCustomer: (token: opt text, input: CustomerInput) -> (Customer);
  createExpense: (token: opt text, input: ExpenseInput) -> (Expense);
  createExpenseCategory: (token: opt text, input: ExpenseCategoryInput) ->
   (ExpenseCategory);
  createInvoiceFromOrder: (token: opt text, orderId: Id, paymentMethod:
   PaymentMethod, paymentCondition: PaymentCondition, creditPlan:
   opt CreditPlanInput) -> (Invoice);
  createInvoiceFromPosSale: (token: opt text, posSaleId: Id, customerId:
   opt Id, customerName: opt text, lines: vec InvoiceLine, discount: 
   Money, paymentMethod: PaymentMethod, paymentCondition: PaymentCondition,
   creditPlan: opt CreditPlanInput) -> (Invoice);
  createInvoiceFromQuote: (token: opt text, quoteId: Id, customerId: 
   Id, lines: vec InvoiceLine, discount: Money, paymentMethod: PaymentMethod,
   paymentCondition: PaymentCondition, creditPlan: opt CreditPlanInput) ->
   (Invoice);
  createMotorcycle: (token: opt text, input: MotorcycleInput) -> (Motorcycle);
  createOrder: (token: opt text, input: OrderInput) -> (OrderView);
  createPart: (token: opt text, input: PartInput) -> (PartView);
  createPosSale: (token: opt text, input: PosSaleInput) -> (PosSale);
  createPurchase: (token: opt text, input: PurchaseInput) -> (Purchase);
  createPurchaseInvoiceDraft: (token: opt text, input: CreateInvoiceInput) ->
   (PurchaseInvoice);
  createQuote: (token: opt text, input: QuoteInput) -> (QuoteView);
  createRole: (token: opt text, input: RoleInput) -> (Role);
  createService: (token: opt text, input: ServiceInput) -> (Service);
  createServiceCategory: (token: opt text, input: ServiceCategoryInput) ->
   (ServiceCategory);
  createSupplier: (token: opt text, input: SupplierInput) -> (Supplier);
  createSupplierOrder: (token: opt text, input: SupplierOrderInput) ->
   (SupplierOrder);
  createTechnician: (token: opt text, input: TechnicianInput) -> (Technician);
  createTechnicianLoan: (token: opt text, input: TechnicianLoanInput) ->
   (TechnicianLoan);
  createUser: (token: opt text, username: text, name: text, roleId: Id,
   temporaryPassword: text) -> (UserListItem);
  deleteAppointment: (token: opt text, id: Id) -> (bool);
  deleteExpense: (token: opt text, id: Id) -> (bool);
  deleteExpenseCategory: (token: opt text, id: Id) -> (bool);
  deleteInvoice: (token: opt text, id: Id) -> (bool);
  deleteOrder: (token: opt text, id: Id) -> (bool);
  deletePurchase: (token: opt text, id: Id) -> (bool);
  deleteQuote: (token: opt text, id: Id) -> (bool);
  deleteRole: (token: opt text, roleId: Id) -> (bool);
  deleteService: (token: opt text, id: Id) -> (bool);
  deleteServiceCategory: (token: opt text, id: Id) -> (bool);
  deleteTechnician: (token: opt text, id: Id) -> (bool);
  deleteTechnicianLoan: (token: opt text, id: Id) -> (bool);
  deleteUser: (token: opt text, userId: Id) -> (bool);
  /// Revoca la conexión con Google Drive del administrador.
  disconnectDrive: (token: opt text) -> ();
  execute: (qJson: text) -> (Result) query;
  exportCustomersAggregated: (token: opt text) ->
   (vec CustomerExportRow) query;
  exportInventoryCsv: (token: opt text) -> (vec InventoryCsvRow) query;
  /// Busca un repuesto por **código de barras o SKU**. La comparación ignora
  /// mayúsculas y espacios externos; el código de barras tiene prioridad sobre
  /// el SKU. Devuelve `#found` con la vista del repuesto o `#notFound` cuando
  /// el código está vacío o no coincide con ningún repuesto. Es la vía que usa
  /// el lector de códigos de barras del POS y de los demás formatos.
  findPartByCode: (token: opt text, code: text) -> (PartLookupResult) query;
  findTechnicianByCode: (token: opt text, code: text) ->
   (opt Technician) query;
  getAccountingReport: (token: opt text, period: AccountingPeriod) ->
   (AccountingReport) query;
  getAccountingSummary: (token: opt text, period: AccountingPeriod) ->
   (AccountingSummary) query;
  getApiDoc: () -> (text) query;
  getAppointment: (token: opt text, id: Id) -> (opt Appointment) query;
  /// Devuelve una página de una sección del respaldo. `index` es la posición
  /// dentro de `manifest.sections`; `offset` y `limit` paginan las secciones de
  /// colección (las de un único registro los ignoran). `limit` se acota a
  /// `manifest.maxPageSize`. El frontend concatena las páginas de cada sección
  /// hasta que `done` sea `true`.
  /// 
  /// Es una **consulta** de solo lectura: serializa únicamente la página
  /// pedida, de modo que ninguna llamada se acerca al límite de instrucciones
  /// por mensaje.
  getBackupSection: (token: opt text, index: nat, offset: nat, limit: 
   nat) -> (BackupSectionChunk) query;
  getBusinessSettings: (token: opt text) -> (BusinessSettings) query;
  getCallerUserProfile: () -> (opt UserProfile) query;
  getCallerUserRole: () -> (UserRole) query;
  getCommissionPayment: (token: opt text, id: Id) ->
   (opt CommissionPayment) query;
  getCommissionReport: (token: opt text, period: CommissionPeriod) ->
   (CommissionReport) query;
  getCompanyProfile: (token: opt text) -> (CompanyProfile) query;
  getCustomer: (token: opt text, id: Id) -> (opt Customer) query;
  getCustomerDetail: (token: opt text, id: Id) -> (opt CustomerDetail) query;
  getDailyHopeMessage: () -> (HopeMessage) query;
  getDailyShiftReport: (token: opt text, shiftId: Id) ->
   (DailyShiftReport) query;
  getDashboardSummary: (token: opt text) -> (DashboardSummary) query;
  /// Estado de la conexión con Google Drive del administrador. Es tolerante a
  /// credenciales ausentes: nunca lanza un trap por configuración faltante y
  /// siempre incluye `configuration` con las variables ausentes. Es una
  /// actualización (no consulta) porque lee las variables de entorno del
  /// canister, que requieren la capacidad `<system>`.
  getDriveConnectionStatus: (token: opt text) -> (DriveConnectionStatus);
  getExpense: (token: opt text, id: Id) -> (opt Expense) query;
  getExpenseCategory: (token: opt text, id: Id) ->
   (opt ExpenseCategory) query;
  getExpenseSummary: (token: opt text, filter: ExpenseFilter) ->
   (ExpenseSummary) query;
  getHopeSettings: (token: opt text) -> (HopeSettings) query;
  getInventoryValuation: (token: opt text) -> (InventoryValuation) query;
  getInvoice: (token: opt text, id: Id) -> (opt Invoice) query;
  /// Manifiesto de la copia de seguridad local: devuelve el nombre del archivo,
  /// el momento de generación y el plan ordenado de secciones, **sin**
  /// serializar ningún dato. Es una **consulta** de solo lectura.
  /// 
  /// El frontend arma el JSON raíz así:
  /// `{ "generatedAt": <generatedAt>, "<sections[0]>": <valor>, ... }`, donde
  /// cada valor se obtiene con `getBackupSection(index, offset, limit)`.
  getLocalBackupManifest: (token: opt text) -> (LocalBackupManifest) query;
  getOpenShift: (token: opt text) -> (opt Shift) query;
  getOrder: (token: opt text, id: Id) -> (opt OrderView) query;
  getPart: (token: opt text, id: Id) -> (opt PartView) query;
  getPayable: (token: opt text, supplierId: Id) -> (opt Payable) query;
  getPosSale: (token: opt text, id: Id) -> (opt PosSale) query;
  getPurchaseInvoice: (token: opt text, invoiceId: Id) ->
   (opt PurchaseInvoice) query;
  getQuote: (token: opt text, id: Id) -> (opt QuoteView) query;
  getReceivableSummary: (token: opt text) -> (ReceivableSummary) query;
  getRemindersSummary: (token: opt text) -> (RemindersSummary) query;
  getService: (token: opt text, id: Id) -> (opt Service) query;
  getServiceCategory: (token: opt text, id: Id) ->
   (opt ServiceCategory) query;
  getServiceTermsSettings: (token: opt text) -> (ServiceTermsSettings) query;
  getSession: (token: text) -> (opt SessionInfo) query;
  getShift: (token: opt text, id: Id) -> (opt Shift) query;
  getSupplier: (token: opt text, id: Id) -> (opt Supplier) query;
  getTechnician: (token: opt text, id: Id) -> (opt Technician) query;
  getTechnicianCommissionSummary: (token: opt text, technicianId: Id, period:
   CommissionPeriod) -> (opt TechnicianCommissionSummary) query;
  getTechnicianLoan: (token: opt text, id: Id) -> (opt TechnicianLoan) query;
  getTechnicianWorkload: (token: opt text, technicianId: Id) ->
   (opt TechnicianWorkload) query;
  getWarrantyTermsSettings: (token: opt text) ->
   (WarrantyTermsSettings) query;
  importInventoryCsv: (token: opt text, rows: vec InventoryImportRow) ->
   (InventoryImportResult);
  isCallerAdmin: () -> (bool) query;
  listAppointments: (token: opt text, filter: AppointmentFilter) ->
   (vec Appointment) query;
  /// Lista los respaldos recientes desde el Drive del administrador.
  listBackups: (token: opt text) -> (BackupListOutcome);
  listCashMovements: (token: opt text, filter: CashMovementFilter, offset:
   nat, limit: nat) -> (CashMovementPage) query;
  listCommissionLines: (token: opt text, technicianId: opt Id, period:
   CommissionPeriod) -> (vec CommissionLine) query;
  listCommissionPayments: (token: opt text, filter:
   CommissionPaymentFilter) -> (vec CommissionPayment) query;
  listCustomers: (token: opt text, search: opt text) -> (vec Customer) query;
  listCustomersPage: (token: opt text, filter: CustomerFilter, sort:
   CustomerSort, offset: nat, limit: nat) -> (CustomerPage) query;
  listCustomersPageDir: (token: opt text, filter: CustomerFilter, sort:
   CustomerSort, descending: bool, offset: nat, limit: nat) ->
   (CustomerPage) query;
  listExpenseCategories: (token: opt text, filter: ExpenseCategoryFilter) ->
   (vec ExpenseCategoryUsage) query;
  listExpenses: (token: opt text, filter: ExpenseFilter, offset: nat, limit:
   nat) -> (ExpensePage) query;
  listInvoices: (token: opt text, filter: InvoiceFilter__1, offset: nat,
   limit: nat) -> (InvoicePage__1) query;
  listLedgerEntries: (token: opt text, period: AccountingPeriod) ->
   (vec LedgerEntry) query;
  listLots: (token: opt text, partId: Id) -> (vec Lot) query;
  listMotorcycleCountsByCustomers: (token: opt text, ids: vec Id) ->
   (vec record {
          Id;
          nat;
        }) query;
  listMotorcycles: (token: opt text, customerId: Id) ->
   (vec Motorcycle) query;
  listMotorcyclesPage: (token: opt text, filter: MotorcycleFilter, sort:
   MotorcycleSort, offset: nat, limit: nat) -> (MotorcyclePage) query;
  listMotorcyclesPageDir: (token: opt text, filter: MotorcycleFilter, sort:
   MotorcycleSort, descending: bool, offset: nat, limit: nat) ->
   (MotorcyclePage) query;
  listMovements: (token: opt text, partId: Id) -> (vec Movement) query;
  listOrders: (token: opt text, filter: OrderFilter, offset: nat, limit:
   nat) -> (OrderPage) query;
  listPartFacets: (token: opt text) -> (PartFacets) query;
  listParts: (token: opt text, filter: PartFilter, sort: PartSort, offset:
   nat, limit: nat) -> (PartPage) query;
  listPartsDir: (token: opt text, filter: PartFilter, sort: PartSort,
   descending: bool, offset: nat, limit: nat) -> (PartPage) query;
  listPayables: (token: opt text) -> (vec Payable) query;
  listPayments: (token: opt text, supplierId: opt Id) -> (vec Payment) query;
  listPosSales: (token: opt text, filter: PosSaleFilter, offset: nat, limit:
   nat) -> (PosSalePage) query;
  listPurchaseInvoices: (token: opt text, filter: InvoiceFilter, sort:
   InvoiceSort, offset: nat, limit: nat) -> (InvoicePage) query;
  listPurchases: (token: opt text, supplierId: opt Id) ->
   (vec Purchase) query;
  listQuotes: (token: opt text, filter: QuoteFilter, sort: QuoteSort, offset:
   nat, limit: nat) -> (QuotePage) query;
  listReceivables: (token: opt text, filter: ReceivableFilter) ->
   (vec Receivable) query;
  listRoles: (token: opt text) -> (vec Role) query;
  listServiceCategories: (token: opt text, filter: ServiceCategoryFilter) ->
   (vec ServiceCategoryUsage) query;
  listServices: (token: opt text, filter: ServiceFilter, sort: ServiceSort,
   offset: nat, limit: nat) -> (ServicePage) query;
  listShifts: (token: opt text, filter: ShiftFilter, offset: nat, limit:
   nat) -> (ShiftPage) query;
  listSupplierOrders: (token: opt text, filter: SupplierOrderFilter) ->
   (vec SupplierOrder) query;
  listSuppliers: (token: opt text, search: opt text) -> (vec Supplier) query;
  listTechnicianLoans: (token: opt text, filter: TechnicianLoanFilter) ->
   (vec TechnicianLoan) query;
  listTechnicianWorkload: (token: opt text) -> (vec TechnicianWorkload) query;
  listTechnicians: (token: opt text, filter: TechnicianFilter) ->
   (vec Technician) query;
  listUsersPage: (token: opt text, search: opt text, offset: nat, limit:
   nat) -> (UserPage) query;
  login: (username: text, password: text) -> (LoginResult);
  logout: (token: text) -> (bool);
  lowStockParts: (token: opt text) -> (vec PartView) query;
  markInvoicePaid: (token: opt text, id: Id, paymentMethod: PaymentMethod) ->
   (Invoice);
  notifyCustomer: (input: CustomerNotificationInput) ->
   (CustomerNotificationResult);
  openShift: (token: opt text, input: OpenShiftInput) -> (Shift);
  payTechnicianCommission: (token: opt text, input:
   CommissionPaymentInput) -> (CommissionPayment);
  prepareWhatsAppMessage: (input: WhatsAppMessageInput) ->
   (WhatsAppMessageResult) query;
  registerCashMovement: (token: opt text, input: CashMovementInput) ->
   (CashMovement);
  registerInstallmentPayment: (token: opt text, id: Id, installmentNumber:
   nat) -> (Invoice);
  registerPayment: (token: opt text, input: PaymentInput) -> (Payment);
  registerReceivablePayment: (token: opt text, input:
   ReceivablePaymentInput) -> (ReceivablePayment);
  removeLabor: (token: opt text, id: Id, laborId: Id) -> (OrderView);
  removeOrderPart: (token: opt text, id: Id, orderPartId: Id) -> (OrderView);
  removeOrderPhoto: (token: opt text, id: Id, photoId: Id) -> (OrderView);
  resetUserPassword: (token: opt text, userId: Id) -> (ResetPasswordResult);
  /// Restaura **una** sección del archivo de copia local, sobrescribiendo solo
  /// esa colección. `index` es la posición dentro de `manifest.sections`
  /// (el mismo orden de `SECTION_KEYS`). El frontend llama una vez por sección
  /// seleccionada, de modo que ninguna llamada procesa el archivo completo y
  /// se respeta el límite de instrucciones por mensaje.
  /// 
  /// Un archivo inválido, una versión incompatible o una sección con formato
  /// incorrecto se rechazan con un error tipado **sin alterar los datos**.
  restoreSection: (token: opt text, json: text, index: nat) ->
   (RestoreSectionOutcome);
  runPurchaseInvoiceExtraction: (token: opt text, invoiceId: Id) ->
   (PurchaseInvoice);
  saveCallerUserProfile: (name: text) -> (UserProfile);
  schema: () -> (text) query;
  setUserActive: (token: opt text, userId: Id, active: bool) ->
   (UserListItem);
  /// Inicia la autorización OAuth (PKCE) de la cuenta propia del
  /// administrador.
  startDriveAuthorization: (token: opt text) -> (DriveAuthStart);
  transform: (input: TransformationInput) -> (TransformationOutput) query;
  unassignTechnician: (token: opt text, id: Id, technicianId: Id) ->
   (OrderView);
  updateAppointment: (token: opt text, id: Id, input: AppointmentInput) ->
   (Appointment);
  updateAppointmentStatus: (token: opt text, id: Id, status:
   AppointmentStatus) -> (Appointment);
  updateBusinessSettings: (token: opt text, settings: BusinessSettings) ->
   (BusinessSettings);
  updateCallerName: (token: text, name: text) -> (SessionInfo);
  updateCompanyProfile: (token: opt text, input: CompanyProfileRawInput) ->
   (CompanyProfile);
  updateCustomer: (token: opt text, id: Id, input: CustomerInput) ->
   (Customer);
  updateExpense: (token: opt text, id: Id, input: ExpenseInput) -> (Expense);
  updateExpenseCategory: (token: opt text, id: Id, input:
   ExpenseCategoryInput) -> (ExpenseCategory);
  updateHopeSettings: (token: opt text, input: HopeSettingsRawInput) ->
   (HopeSettings);
  updateLaborTechnician: (token: opt text, id: Id, laborId: Id, technicianId:
   opt Id) -> (OrderView);
  updateMotorcycle: (token: opt text, id: Id, input: MotorcycleInput) ->
   (Motorcycle);
  updateOrderStatus: (token: opt text, id: Id, status: OrderStatus) ->
   (OrderView);
  updatePart: (token: opt text, id: Id, input: PartInput) -> (PartView);
  updatePurchaseInvoiceReview: (token: opt text, invoiceId: Id, input:
   InvoiceReviewInput) -> (PurchaseInvoice);
  updateQuote: (token: opt text, id: Id, input: QuoteInput) -> (QuoteView);
  updateQuoteStatus: (token: opt text, id: Id, status: QuoteStatus) ->
   (QuoteView);
  updateRole: (token: opt text, roleId: Id, input: RoleInput) -> (Role);
  updateService: (token: opt text, id: Id, input: ServiceInput) -> (Service);
  updateServiceCategory: (token: opt text, id: Id, input:
   ServiceCategoryInput) -> (ServiceCategory);
  updateServiceTermsSettings: (token: opt text, input:
   ServiceTermsSettingsRawInput) -> (ServiceTermsSettings);
  updateSupplier: (token: opt text, id: Id, input: SupplierInput) ->
   (Supplier);
  updateTechnician: (token: opt text, id: Id, input: TechnicianInput) ->
   (Technician);
  updateUserRole: (token: opt text, userId: Id, roleId: Id) -> (UserListItem);
  updateWarrantyTermsSettings: (token: opt text, input:
   WarrantyTermsSettingsRawInput) -> (WarrantyTermsSettings);
  /// Valida un archivo de copia local y devuelve su vista previa (fecha de
  /// generación y secciones presentes) **sin alterar ningún dato**. El
  /// frontend la usa para mostrar la confirmación antes de restaurar.
  /// 
  /// Es una **actualización** (no consulta) porque recibe el contenido del
  /// archivo como parámetro; no modifica el estado.
  validateRestoreFile: (token: opt text, json: text) ->
   (RestorePreviewOutcome);
  zeroInventory: (token: opt text) -> (ZeroInventoryResult);
  zeroServices: (token: opt text) -> (ZeroServicesResult);
}
