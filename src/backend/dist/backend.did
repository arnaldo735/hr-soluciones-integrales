type ExpensePage = 
 record {
   items: vec Expense;
   limit: nat;
   offset: nat;
   summary: ExpenseSummary;
   total: nat;
 };
type ExpenseInput = 
 record {
   amount: Money;
   categoryId: Id;
   concept: text;
   date: Timestamp;
   paymentMethod: text;
   receiptUrl: opt text;
   supplierId: opt Id;
   tax: Money;
 };
type ExpenseFilter = 
 record {
   categoryId: opt Id;
   from: opt Timestamp;
   paymentMethod: opt text;
   search: opt text;
   to: opt Timestamp;
 };
type ExpenseCategoryUsage = 
 record {
   category: ExpenseCategory;
   expenseCount: nat;
 };
type ExpenseCategoryTotal = 
 record {
   categoryId: Id;
   categoryName: text;
   total: Money;
 };
type ExpenseCategoryInput = 
 record {
   description: text;
   name: text;
 };
type ExpenseCategoryFilter = record {search: opt text;};
type ExpenseCategory = 
 record {
   createdAt: Timestamp;
   description: text;
   id: Id;
   name: text;
 };
type Expense = 
 record {
   amount: Money;
   categoryId: Id;
   categoryName: text;
   concept: text;
   createdAt: Timestamp;
   date: Timestamp;
   id: Id;
   paymentMethod: text;
   receiptUrl: opt text;
   supplierId: opt Id;
   supplierName: opt text;
   tax: Money;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type DriveConnectionStatus = 
 record {
   accountEmail: opt text;
   configuration: DriveConfigStatus;
   connected: bool;
   connectedAt: opt int;
 };
type DriveConfigStatus = 
 record {
   configured: bool;
   missingVariables: vec text;
 };
type DriveAuthStart = 
 record {
   authorizationUrl: text;
   state: text;
 };
type DriveAuthResult = 
 record {
   accountEmail: opt text;
   connected: bool;
 };
type DocumentType = 
 variant {
   cedulaCiudadania;
   cedulaExtranjeria;
   nit;
 };
type DashboardSummary = 
 record {
   activeOrders: vec OrderStatusCount;
   lowStock: vec LowStockItem;
   pendingPayablesCount: nat;
   pendingPayablesTotal: Money;
 };
type CustomerSort = 
 variant {
   createdAt;
   motorcycleCount;
   name;
 };
type CustomerPage = 
 record {
   items: vec CustomerListItem;
   limit: nat;
   offset: nat;
   total: nat;
 };
type CustomerOrderSummary = 
 record {
   createdAt: Timestamp;
   motorcyclePlate: text;
   orderId: Id;
   orderNumber: text;
   status: text;
   total: nat;
 };
type CustomerNotificationResult = 
 record {
   customerId: Id;
   email: text;
   sent: bool;
 };
type CustomerNotificationInput = 
 record {
   customerId: Id;
   message: text;
   referenceId: opt Id;
   source: NotificationSource;
   subject: text;
 };
type CustomerListItem = 
 record {
   address: opt text;
   createdAt: Timestamp;
   document: opt text;
   email: opt text;
   id: Id;
   motorcycleCount: nat;
   name: text;
   phone: text;
 };
type CustomerInput = 
 record {
   address: opt text;
   document: opt text;
   email: opt text;
   name: text;
   phone: text;
 };
type CustomerFilter = 
 record {
   hasMotorcycles: opt bool;
   search: opt text;
 };
type CustomerExportRow = 
 record {
   customer: Customer;
   motorcycles: vec Motorcycle;
 };
type CustomerDetail = 
 record {
   customer: Customer;
   motorcycles: vec Motorcycle;
   orders: vec CustomerOrderSummary;
 };
type Customer = 
 record {
   address: opt text;
   createdAt: Timestamp;
   document: opt text;
   email: opt text;
   id: Id;
   name: text;
   phone: text;
 };
type CreditPlanInput = 
 record {
   firstDueDate: Timestamp;
   installmentCount: nat;
 };
type CreateInvoiceInput = 
 record {
   fileName: text;
   gatewayUrl: opt text;
   kind: InvoiceFileKind;
   mimeType: text;
   objectId: text;
   projectId: opt text;
   sizeBytes: nat;
 };
type CompanyProfileRawInput = 
 record {
   address: text;
   checkDigit: opt nat;
   city: text;
   documentType: text;
   email: opt text;
   fiscalRegime: text;
   legalName: text;
   logoUrl: opt text;
   phone: text;
   taxId: text;
   taxRate: TaxRate;
   taxResponsibility: text;
   tradeName: opt text;
   website: opt text;
 };
type CompanyProfile = 
 record {
   address: text;
   checkDigit: opt nat;
   city: text;
   documentType: DocumentType;
   email: opt text;
   fiscalRegime: FiscalRegime;
   legalName: text;
   logoUrl: opt text;
   phone: text;
   taxId: text;
   taxRate: TaxRate;
   taxResponsibility: TaxResponsibility;
   tradeName: opt text;
   updatedAt: Timestamp;
   website: opt text;
 };
type CommissionReport = 
 record {
   period: CommissionPeriod;
   technicians: vec TechnicianCommissionSummary;
   totalBase: Money;
   totalCommission: Money;
   totalNetPayable: Money;
   totalPendingLoans: Money;
 };
type CommissionPeriod = 
 record {
   from: opt Timestamp;
   to: opt Timestamp;
 };
type CommissionPaymentLoan = 
 record {
   amount: Money;
   date: Timestamp;
   loanId: Id;
   note: opt text;
 };
type CommissionPaymentInput = 
 record {
   period: CommissionPeriod;
   technicianId: Id;
 };
type CommissionPaymentFilter = 
 record {
   from: opt Timestamp;
   technicianId: opt Id;
   to: opt Timestamp;
 };
type CommissionPayment = 
 record {
   baseAmount: Money;
   commissionAmount: Money;
   id: Id;
   lineCount: nat;
   lines: vec CommissionLine;
   loans: vec CommissionPaymentLoan;
   loansDeducted: Money;
   netPaid: Money;
   paidAt: Timestamp;
   paidBy: principal;
   period: CommissionPeriod;
   technicianCode: text;
   technicianId: Id;
   technicianName: text;
 };
type CommissionLine = 
 record {
   at: Timestamp;
   baseAmount: Money;
   commissionAmount: Money;
   commissionRate: nat;
   description: text;
   laborId: Id;
   motorcycleBrand: text;
   motorcycleModel: text;
   motorcyclePlate: text;
   orderId: Id;
   orderNumber: text;
   serviceDate: Timestamp;
   serviceId: Id;
   serviceName: text;
   technicianCode: text;
   technicianId: Id;
   technicianName: text;
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
type CategoryBreakdown = 
 record {
   category: text;
   total: Money;
 };
type BusinessSettings = 
 record {
   address: text;
   name: text;
   phone: text;
   taxId: text;
   taxRate: TaxRate;
 };
type BulkRowResult = 
 record {
   error: opt text;
   id: opt Id;
   index: nat;
   ok: bool;
 };
type BulkResult = 
 record {
   created: nat;
   failed: nat;
   rows: vec BulkRowResult;
   skipped: nat;
   updated: nat;
 };
type BasisPoints = nat;
type BackupResult = 
 record {
   createdAt: int;
   fileId: text;
   name: text;
   size: nat;
   webViewLink: text;
 };
type BackupOutcome = 
 variant {
   err: BackupError;
   ok: BackupResult;
 };
type BackupListOutcome = 
 variant {
   err: BackupError;
   ok: vec BackupFile;
 };
type BackupFile = 
 record {
   createdAt: int;
   fileId: text;
   name: text;
   size: nat;
   webViewLink: text;
 };
type BackupError = 
 variant {
   driveFailed: text;
   notAuthorized;
   notConnected;
 };
type AppointmentStatus = 
 variant {
   attended;
   cancelled;
   confirmed;
   noShow;
   scheduled;
 };
type AppointmentInput = 
 record {
   customerId: Id;
   durationMinutes: nat;
   motorcycleId: Id;
   reason: text;
   scheduledAt: Timestamp;
   technicianId: opt Id;
 };
type AppointmentFilter = 
 record {
   from: opt Timestamp;
   status: opt AppointmentStatus;
   technicianId: opt Id;
   to: opt Timestamp;
 };
type Appointment = 
 record {
   createdAt: Timestamp;
   customerId: Id;
   durationMinutes: nat;
   id: Id;
   motorcycleId: Id;
   reason: text;
   scheduledAt: Timestamp;
   status: AppointmentStatus;
   technicianId: opt Id;
   updatedAt: Timestamp;
 };
type AdjustmentInput = 
 record {
   direction: AdjustmentDirection;
   lotId: opt Id;
   partId: Id;
   quantity: nat;
   reason: text;
 };
type AdjustmentDirection = 
 variant {
   in;
   out;
 };
type AccountingSummary = 
 record {
   expenseCount: nat;
   from: opt Timestamp;
   invoiceCount: nat;
   profit: int;
   to: opt Timestamp;
   totalExpenses: Money;
   totalIncome: Money;
 };
type AccountingReport = 
 record {
   byExpenseCategory: vec CategoryBreakdown;
   byPaymentMethod: vec PaymentMethodBreakdown;
   entries: vec LedgerEntry;
   profit: ProfitBreakdown;
   summary: AccountingSummary;
 };
type AccountingPeriod = 
 record {
   from: opt Timestamp;
   to: opt Timestamp;
 };
service : {
  _immutableObjectStorageBlobsAreLive: (hashes: vec blob) -> (vec bool) query;
  _immutableObjectStorageBlobsToDelete: () -> (vec blob) query;
  _immutableObjectStorageConfirmBlobDeletion: (blobs: vec blob) -> ();
  _immutableObjectStorageCreateCertificate: (blobHash: text) ->
   (_ImmutableObjectStorageCreateCertificateResult);
  _immutableObjectStorageRefillCashier: (refillInformation:
   opt _ImmutableObjectStorageRefillInformation) ->
   (_ImmutableObjectStorageRefillResult);
  _immutableObjectStorageUpdateGatewayPrincipals: () -> ();
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  addLabor: (id: Id, input: LaborInput) -> (OrderView);
  addOrderPart: (id: Id, input: OrderPartInput) -> (OrderView);
  addOrderPhoto: (id: Id, input: OrderPhotoInput) -> (OrderView);
  adjustStock: (input: AdjustmentInput) -> (Movement);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  assignTechnician: (id: Id, technicianId: Id) -> (OrderView);
  bulkCreateCustomers: (inputs: vec CustomerInput) -> (BulkResult);
  bulkCreateParts: (inputs: vec PartInput) -> (BulkResult);
  bulkCreateServices: (inputs: vec ServiceInput) -> (vec Service);
  bulkUpdateCustomers: (updates: vec record {
                                       Id;
                                       CustomerInput;
                                     }) -> (BulkResult);
  bulkUpdateParts: (updates: vec record {
                                   Id;
                                   PartInput;
                                 }) -> (BulkResult);
  bulkUpdateServices: (updates: vec record {
                                      Id;
                                      ServiceInput;
                                    }) -> (vec Service);
  cancelOrder: (id: Id, reason: text) -> (OrderView);
  /// Completa la autorización OAuth con el código devuelto por Google.
  completeDriveAuthorization: (code: text, state: text) -> (DriveAuthResult);
  confirmPurchaseInvoice: (invoiceId: Id) -> (InvoiceApplyResult);
  convertAppointmentToOrder: (id: Id) -> (OrderView);
  convertQuoteToInvoice: (id: Id, paymentMethod: PaymentMethod) -> (Invoice);
  convertQuoteToOrder: (id: Id) -> (OrderView);
  createAppointment: (input: AppointmentInput) -> (Appointment);
  /// Genera el respaldo y lo sube al Drive del administrador.
  createBackup: () -> (BackupOutcome);
  createCustomer: (input: CustomerInput) -> (Customer);
  createExpense: (input: ExpenseInput) -> (Expense);
  createExpenseCategory: (input: ExpenseCategoryInput) -> (ExpenseCategory);
  createInvoiceFromOrder: (orderId: Id, paymentMethod: PaymentMethod,
   paymentCondition: PaymentCondition, creditPlan: opt CreditPlanInput) ->
   (Invoice);
  createInvoiceFromPosSale: (posSaleId: Id, customerId: opt Id, customerName:
   opt text, lines: vec InvoiceLine, discount: Money, paymentMethod:
   PaymentMethod, paymentCondition: PaymentCondition, creditPlan:
   opt CreditPlanInput) -> (Invoice);
  createInvoiceFromQuote: (quoteId: Id, customerId: Id, lines:
   vec InvoiceLine, discount: Money, paymentMethod: PaymentMethod,
   paymentCondition: PaymentCondition, creditPlan: opt CreditPlanInput) ->
   (Invoice);
  createMotorcycle: (input: MotorcycleInput) -> (Motorcycle);
  createOrder: (input: OrderInput) -> (OrderView);
  createPart: (input: PartInput) -> (PartView);
  createPosSale: (input: PosSaleInput) -> (PosSale);
  createPurchase: (input: PurchaseInput) -> (Purchase);
  createPurchaseInvoiceDraft: (input: CreateInvoiceInput) ->
   (PurchaseInvoice);
  createQuote: (input: QuoteInput) -> (QuoteView);
  createService: (input: ServiceInput) -> (Service);
  createServiceCategory: (input: ServiceCategoryInput) -> (ServiceCategory);
  createSupplier: (input: SupplierInput) -> (Supplier);
  createSupplierOrder: (input: SupplierOrderInput) -> (SupplierOrder);
  createTechnician: (input: TechnicianInput) -> (Technician);
  createTechnicianLoan: (input: TechnicianLoanInput) -> (TechnicianLoan);
  deleteAppointment: (id: Id) -> (bool);
  deleteExpense: (id: Id) -> (bool);
  deleteExpenseCategory: (id: Id) -> (bool);
  deleteOrder: (id: Id) -> (bool);
  deleteQuote: (id: Id) -> (bool);
  deleteService: (id: Id) -> (bool);
  deleteServiceCategory: (id: Id) -> (bool);
  deleteTechnician: (id: Id) -> (bool);
  deleteTechnicianLoan: (id: Id) -> (bool);
  /// Revoca la conexión con Google Drive del administrador.
  disconnectDrive: () -> ();
  /// Genera la copia de seguridad local: devuelve el mismo JSON que el
  /// respaldo a Drive y el nombre del archivo con fecha y hora, para que el
  /// frontend lo descargue en el equipo del usuario. Es una **consulta** de
  /// solo lectura: no espera a ningún canister ni muta estado.
  downloadLocalBackup: () -> (LocalBackup) query;
  execute: (qJson: text) -> (Result) query;
  exportCustomersAggregated: () -> (vec CustomerExportRow) query;
  exportInventoryCsv: () -> (vec InventoryCsvRow) query;
  findTechnicianByCode: (code: text) -> (opt Technician) query;
  getAccountingReport: (period: AccountingPeriod) -> (AccountingReport) query;
  getAccountingSummary: (period: AccountingPeriod) ->
   (AccountingSummary) query;
  getApiDoc: () -> (text) query;
  getAppointment: (id: Id) -> (opt Appointment) query;
  getBusinessSettings: () -> (BusinessSettings) query;
  getCallerUserProfile: () -> (opt UserProfile) query;
  getCallerUserRole: () -> (UserRole) query;
  getCommissionPayment: (id: Id) -> (opt CommissionPayment) query;
  getCommissionReport: (period: CommissionPeriod) -> (CommissionReport) query;
  getCompanyProfile: () -> (CompanyProfile) query;
  getCustomer: (id: Id) -> (opt Customer) query;
  getCustomerDetail: (id: Id) -> (opt CustomerDetail) query;
  getDashboardSummary: () -> (DashboardSummary) query;
  /// Estado de la conexión con Google Drive del administrador. Es tolerante a
  /// credenciales ausentes: nunca lanza un trap por configuración faltante y
  /// siempre incluye `configuration` con las variables ausentes. Es una
  /// actualización (no consulta) porque lee las variables de entorno del
  /// canister, que requieren la capacidad `<system>`.
  getDriveConnectionStatus: () -> (DriveConnectionStatus);
  getExpense: (id: Id) -> (opt Expense) query;
  getExpenseCategory: (id: Id) -> (opt ExpenseCategory) query;
  getExpenseSummary: (filter: ExpenseFilter) -> (ExpenseSummary) query;
  getInventoryValuation: () -> (InventoryValuation) query;
  getInvoice: (id: Id) -> (opt Invoice) query;
  getOrder: (id: Id) -> (opt OrderView) query;
  getPart: (id: Id) -> (opt PartView) query;
  getPayable: (supplierId: Id) -> (opt Payable) query;
  getPosSale: (id: Id) -> (opt PosSale) query;
  getPurchaseInvoice: (invoiceId: Id) -> (opt PurchaseInvoice) query;
  getQuote: (id: Id) -> (opt QuoteView) query;
  getReceivableSummary: () -> (ReceivableSummary) query;
  getService: (id: Id) -> (opt Service) query;
  getServiceCategory: (id: Id) -> (opt ServiceCategory) query;
  getSupplier: (id: Id) -> (opt Supplier) query;
  getTechnician: (id: Id) -> (opt Technician) query;
  getTechnicianCommissionSummary: (technicianId: Id, period:
   CommissionPeriod) -> (opt TechnicianCommissionSummary) query;
  getTechnicianLoan: (id: Id) -> (opt TechnicianLoan) query;
  getTechnicianWorkload: (technicianId: Id) -> (opt TechnicianWorkload) query;
  importInventoryCsv: (rows: vec InventoryImportRow) ->
   (InventoryImportResult);
  isCallerAdmin: () -> (bool) query;
  listAppointments: (filter: AppointmentFilter) -> (vec Appointment) query;
  /// Lista los respaldos recientes desde el Drive del administrador.
  listBackups: () -> (BackupListOutcome);
  listCommissionLines: (technicianId: opt Id, period: CommissionPeriod) ->
   (vec CommissionLine) query;
  listCommissionPayments: (filter: CommissionPaymentFilter) ->
   (vec CommissionPayment) query;
  listCustomers: (search: opt text) -> (vec Customer) query;
  listCustomersPage: (filter: CustomerFilter, sort: CustomerSort, offset:
   nat, limit: nat) -> (CustomerPage) query;
  listCustomersPageDir: (filter: CustomerFilter, sort: CustomerSort,
   descending: bool, offset: nat, limit: nat) -> (CustomerPage) query;
  listExpenseCategories: (filter: ExpenseCategoryFilter) ->
   (vec ExpenseCategoryUsage) query;
  listExpenses: (filter: ExpenseFilter, offset: nat, limit: nat) ->
   (ExpensePage) query;
  listInvoices: (filter: InvoiceFilter__1, offset: nat, limit: nat) ->
   (InvoicePage__1) query;
  listLedgerEntries: (period: AccountingPeriod) -> (vec LedgerEntry) query;
  listLots: (partId: Id) -> (vec Lot) query;
  listMotorcycleCountsByCustomers: (ids: vec Id) ->
   (vec record {
          Id;
          nat;
        }) query;
  listMotorcycles: (customerId: Id) -> (vec Motorcycle) query;
  listMotorcyclesPage: (filter: MotorcycleFilter, sort: MotorcycleSort,
   offset: nat, limit: nat) -> (MotorcyclePage) query;
  listMotorcyclesPageDir: (filter: MotorcycleFilter, sort: MotorcycleSort,
   descending: bool, offset: nat, limit: nat) -> (MotorcyclePage) query;
  listMovements: (partId: Id) -> (vec Movement) query;
  listOrders: (filter: OrderFilter, offset: nat, limit: nat) ->
   (OrderPage) query;
  listPartFacets: () -> (PartFacets) query;
  listParts: (filter: PartFilter, sort: PartSort, offset: nat, limit: 
   nat) -> (PartPage) query;
  listPartsDir: (filter: PartFilter, sort: PartSort, descending: bool,
   offset: nat, limit: nat) -> (PartPage) query;
  listPayables: () -> (vec Payable) query;
  listPayments: (supplierId: opt Id) -> (vec Payment) query;
  listPosSales: (filter: PosSaleFilter, offset: nat, limit: nat) ->
   (PosSalePage) query;
  listPurchaseInvoices: (filter: InvoiceFilter, sort: InvoiceSort, offset:
   nat, limit: nat) -> (InvoicePage) query;
  listPurchases: (supplierId: opt Id) -> (vec Purchase) query;
  listQuotes: (filter: QuoteFilter, sort: QuoteSort, offset: nat, limit:
   nat) -> (QuotePage) query;
  listReceivables: (filter: ReceivableFilter) -> (vec Receivable) query;
  listServiceCategories: (filter: ServiceCategoryFilter) ->
   (vec ServiceCategoryUsage) query;
  listServices: (filter: ServiceFilter, sort: ServiceSort, offset: nat,
   limit: nat) -> (ServicePage) query;
  listSupplierOrders: (filter: SupplierOrderFilter) ->
   (vec SupplierOrder) query;
  listSuppliers: (search: opt text) -> (vec Supplier) query;
  listTechnicianLoans: (filter: TechnicianLoanFilter) ->
   (vec TechnicianLoan) query;
  listTechnicianWorkload: () -> (vec TechnicianWorkload) query;
  listTechnicians: (filter: TechnicianFilter) -> (vec Technician) query;
  listUsers: () -> (vec UserView) query;
  lowStockParts: () -> (vec PartView) query;
  markInvoicePaid: (id: Id, paymentMethod: PaymentMethod) -> (Invoice);
  notifyCustomer: (input: CustomerNotificationInput) ->
   (CustomerNotificationResult);
  payTechnicianCommission: (input: CommissionPaymentInput) ->
   (CommissionPayment);
  prepareWhatsAppMessage: (input: WhatsAppMessageInput) ->
   (WhatsAppMessageResult) query;
  registerInstallmentPayment: (id: Id, installmentNumber: nat) -> (Invoice);
  registerPayment: (input: PaymentInput) -> (Payment);
  registerReceivablePayment: (input: ReceivablePaymentInput) ->
   (ReceivablePayment);
  removeLabor: (id: Id, laborId: Id) -> (OrderView);
  removeOrderPart: (id: Id, orderPartId: Id) -> (OrderView);
  removeOrderPhoto: (id: Id, photoId: Id) -> (OrderView);
  runPurchaseInvoiceExtraction: (invoiceId: Id) -> (PurchaseInvoice);
  saveCallerUserProfile: (name: text) -> (UserProfile);
  schema: () -> (text) query;
  setUserRole: (user: principal, role: UserRole) -> (UserView);
  /// Inicia la autorización OAuth (PKCE) de la cuenta propia del
  /// administrador.
  startDriveAuthorization: () -> (DriveAuthStart);
  transform: (input: TransformationInput) -> (TransformationOutput) query;
  unassignTechnician: (id: Id, technicianId: Id) -> (OrderView);
  updateAppointment: (id: Id, input: AppointmentInput) -> (Appointment);
  updateAppointmentStatus: (id: Id, status: AppointmentStatus) ->
   (Appointment);
  updateBusinessSettings: (settings: BusinessSettings) -> (BusinessSettings);
  updateCompanyProfile: (input: CompanyProfileRawInput) -> (CompanyProfile);
  updateCustomer: (id: Id, input: CustomerInput) -> (Customer);
  updateExpense: (id: Id, input: ExpenseInput) -> (Expense);
  updateExpenseCategory: (id: Id, input: ExpenseCategoryInput) ->
   (ExpenseCategory);
  updateLaborTechnician: (id: Id, laborId: Id, technicianId: opt Id) ->
   (OrderView);
  updateMotorcycle: (id: Id, input: MotorcycleInput) -> (Motorcycle);
  updateOrderStatus: (id: Id, status: OrderStatus) -> (OrderView);
  updatePart: (id: Id, input: PartInput) -> (PartView);
  updatePurchaseInvoiceReview: (invoiceId: Id, input: InvoiceReviewInput) ->
   (PurchaseInvoice);
  updateQuote: (id: Id, input: QuoteInput) -> (QuoteView);
  updateQuoteStatus: (id: Id, status: QuoteStatus) -> (QuoteView);
  updateService: (id: Id, input: ServiceInput) -> (Service);
  updateServiceCategory: (id: Id, input: ServiceCategoryInput) ->
   (ServiceCategory);
  updateSupplier: (id: Id, input: SupplierInput) -> (Supplier);
  updateTechnician: (id: Id, input: TechnicianInput) -> (Technician);
  zeroInventory: () -> (ZeroInventoryResult);
  zeroServices: () -> (ZeroServicesResult);
}
